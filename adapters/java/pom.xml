<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.protocolnok</groupId>
  <artifactId>tripwire-adapter-java</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Single source of truth for the SDK version: referenced below both as the
         dependency version and, via resource filtering, as the string the adapter
         reports at runtime. stellar-sdk-6.0.0.jar embeds no pom.properties of its
         own (unlike most Maven-published libraries), so there's nothing to read
         this back out of at runtime; it has to come from here instead. -->
    <stellar-sdk.version>6.0.0</stellar-sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>network.lightsail</groupId>
      <artifactId>stellar-sdk</artifactId>
      <version>${stellar-sdk.version}</version>
    </dependency>
    <!-- A transitive, runtime-scope dependency of stellar-sdk; declared explicitly
         here (same version) because we use it directly to parse manifest.json. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.protocolnok.tripwire.Adapter</mainClass>
                </transformer>
              </transformers>
              <!-- bcprov-jdk18on (a transitive dep of stellar-sdk) is a signed jar. Shading
                   bundles its per-entry signature under one new manifest, which no longer
                   matches it: the JVM then refuses to load anything with
                   "Invalid signature file digest for Manifest main attributes". Standard
                   fix: drop the signature files, since the shaded jar isn't signed anyway. -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
      </plugin>
    </plugins>
  </build>
</project>
